{
  "name": "hum-to-orchestra",
  "version": "0.1.0",
  "private": false,
  "description": "Hum a melody and hear it arranged as quartet, brass, baroque, electronic, or full orchestra.",
  "type": "module",
  "homepage": "https://baditaflorin.github.io/hum-to-orchestra/",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/hum-to-orchestra.git"
  },
  "bugs": {
    "url": "https://github.com/baditaflorin/hum-to-orchestra/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-pages.mjs && tsc -b && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pages-preview": "node scripts/pages-preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint . && prettier --check .",
    "fmt": "prettier --write .",
    "audit": "npm audit --audit-level=high",
    "install-hooks": "git config core.hooksPath .githooks",
    "hooks:pre-commit": "bash .githooks/pre-commit",
    "hooks:commit-msg": "bash .githooks/commit-msg .git/COMMIT_EDITMSG",
    "hooks:pre-push": "bash .githooks/pre-push",
    "clean": "rm -rf docs node_modules/.vite coverage test-results playwright-report"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "pitchy": "^4.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.2.4",
    "tone": "^15.1.22",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
