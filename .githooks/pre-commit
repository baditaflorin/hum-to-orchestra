#!/usr/bin/env bash
# Docs-only commits (just CLAUDE.md, the fleet-wide canonical doc sync)
# skip the full check suite below — it has nothing to check.
if [ "$(git diff --cached --name-only)" = "CLAUDE.md" ]; then
  exit 0
fi
set -euo pipefail

npm run lint
npx tsc -b --pretty false

if find . -name '*.go' -not -path './node_modules/*' -not -path './docs/*' | grep -q .; then
  gofmt -w $(find . -name '*.go' -not -path './node_modules/*' -not -path './docs/*')
  go vet ./...
  golangci-lint run
fi

gitleaks protect --staged --verbose
